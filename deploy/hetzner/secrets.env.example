# Скопируй в secrets.env и заполни (secrets.env в .gitignore).
# Значения берутся из Railway: railway variables --service backend --kv

# Домен фронта (один origin на UI и API)
FRONTEND_DOMAIN=crm.uniqumsport.kg

# Планировщик: false пока Railway жив, true после его остановки
SCHEDULER_ENABLED=false

# Supabase (общие с Railway — БД не мигрирует)
SUPABASE_URL=https://achvpwatdonjpqanzsgw.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Sentry (пусто = выкл)
SENTRY_DSN=
VITE_SENTRY_DSN=

# Tigris / S3 (файлы, тоже общие с Railway)
MINIO_ENDPOINT=https://t3.storageapi.dev
MINIO_PUBLIC_URL=https://t3.storageapi.dev
MINIO_BUCKET=categorized-box-0a4vz9aym
MINIO_REGION=auto
MINIO_ACCESS_KEY=tid_...
MINIO_SECRET_KEY=tsec_...
HIK_INGEST_SECRET=            # секрет для /v1/hik/* (турникеты), openssl rand -hex 24
ISUP_DEVICE_IDS=uniqum-t1      # ISUP Device ID терминалов через запятую
ISUP_KEY=                      # ключ ISUP (тот же, что введён на терминале)
