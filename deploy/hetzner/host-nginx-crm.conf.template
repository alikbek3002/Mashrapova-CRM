# Хостовый nginx (root). Кладётся в /etc/nginx/sites-available/crm.uniqumsport.kg.conf
# и симлинкуется в sites-enabled. НЕ трогает integrator.conf (pay.uniqumsport.kg).
#
# Порядок применения (на шаге cutover):
#   1) создать этот файл на :80 (без ssl), nginx -t, reload
#   2) certbot --nginx -d crm.uniqumsport.kg   (сам допишет :443-блок и редирект)
#      Для HTTP-01 запись crm в Cloudflare должна быть DNS-only (серое облако).
#
# Ниже — стартовый :80-вариант (до certbot).
server {
    listen 80;
    server_name crm.uniqumsport.kg;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        client_max_body_size 6m;
    }
}
