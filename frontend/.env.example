# =============================================================================
# FRONTEND ENV — Vercel / локальная разработка
# =============================================================================
# ВАЖНО: всё что начинается на VITE_* попадает в bundle и видно в браузере!
# Поэтому СЮДА КЛАДЁМ ТОЛЬКО ПУБЛИЧНЫЕ ключи.
# Service role key, секреты Stripe и т.п. — НИКОГДА здесь.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
# Где взять: Supabase Dashboard → Project Settings → API

# 🌐 ПУБЛИЧНЫЙ — URL проекта
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 🌐 ПУБЛИЧНЫЙ — anon key (в Supabase: "anon public")
# Безопасно показывать в браузере: защита через RLS-политики в БД
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...YOUR_ANON_PUBLIC_KEY


# -----------------------------------------------------------------------------
# BACKEND API
# -----------------------------------------------------------------------------
# 🌐 ПУБЛИЧНЫЙ — URL Railway-бэкенда
# Локально: http://localhost:3001
# Прод: https://your-backend.up.railway.app
VITE_API_URL=http://localhost:3001


# -----------------------------------------------------------------------------
# SENTRY (мониторинг ошибок) — опционально
# -----------------------------------------------------------------------------
# 🌐 ПУБЛИЧНЫЙ — DSN фронт-проекта в Sentry (отдельный от бэкенда!)
# DSN специально дизайнен быть публичным — Sentry это знает
VITE_SENTRY_DSN=
