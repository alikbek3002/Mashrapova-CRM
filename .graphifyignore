# =====================================================================
# graphify — что не попадает в граф знаний проекта
# Синтаксис как у .gitignore. .gitignore учитывается автоматически и
# объединяется с этим файлом; здесь только то, чего в нём нет.
# =====================================================================

# ----- Локи зависимостей: сотни килобайт JSON без архитектурного смысла -----
package-lock.json
**/package-lock.json

# ----- Бинарные ассеты: иконки и логотип PWA -----
# Изображения графу ничего не дают, но уходят на семантический разбор в LLM.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.ico
*.woff
*.woff2

# ----- Артефакты самого graphify -----
graphify-out/

# ----- Локальный стенд Postgres: данные и лог -----
# Уже закрыты supabase/test/.gitignore — дублируем на случай --no-gitignore.
supabase/test/pgdata/
supabase/test/pg.log
supabase/test/node_modules/

# ----- Сборка и кеши -----
dist/
.vite/
*.tsbuildinfo

# ----- Документы заказчика в бинарных форматах -----
# (.docx уже в .gitignore; здесь — чтобы не подхватились из рабочей копии)
*.docx
*.doc
*.pdf
*.xlsx
