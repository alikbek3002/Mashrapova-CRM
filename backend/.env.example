# =============================================================================
# BACKEND ENV — Railway / локальная разработка
# =============================================================================
# Где взять ключи: Supabase Dashboard → Project Settings → API
#   https://app.supabase.com/project/<your-ref>/settings/api
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------

# 🌐 ПУБЛИЧНЫЙ — URL проекта (можно показывать кому угодно)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 🌐 ПУБЛИЧНЫЙ — anon key (тот же что во фронте, в Supabase: "anon public")
# Безопасен для клиента, защищён через RLS
SUPABASE_ANON_KEY=eyJhbGciOi...YOUR_ANON_PUBLIC_KEY

# 🔒 СЕКРЕТНЫЙ — service role key (в Supabase: "service_role secret")
# ⚠️  ОБХОДИТ RLS — полный доступ ко всей БД
# ⚠️  НИКОГДА не коммить в git
# ⚠️  НИКОГДА не давать фронту
# ⚠️  Хранить ТОЛЬКО в Railway env vars и в локальном .env (в .gitignore)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...YOUR_SERVICE_ROLE_SECRET_KEY


# -----------------------------------------------------------------------------
# CORS — список разрешённых origin'ов фронтенда (через запятую)
# -----------------------------------------------------------------------------
# 🌐 ПУБЛИЧНЫЙ (но важно правильно настроить, иначе CORS всех пустит)
# Поддерживаются glob-паттерны с `*` (любое количество символов кроме `/`).
# Примеры:
#   http://localhost:5173               — точный origin (dev)
#   https://mashrapov-academy.vercel.app     — точный origin (prod Vercel)
#   https://*.up.railway.app            — все Railway-деплои (вкл. preview)
#   https://*-mashrapov-academy.vercel.app   — все Vercel preview-деплои
FRONTEND_ORIGINS=http://localhost:5173,https://*.up.railway.app,https://*.vercel.app


# -----------------------------------------------------------------------------
# SENTRY (мониторинг ошибок) — опционально
# -----------------------------------------------------------------------------
# 🔒 СЕКРЕТНЫЙ — DSN бэкенд-проекта в Sentry
# Где взять: sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=


# -----------------------------------------------------------------------------
# MINIO / S3-СОВМЕСТИМОЕ ХРАНИЛИЩЕ (для фото тренеров и т.п.)
# -----------------------------------------------------------------------------
# Если не задано — /v1/uploads/* отвечает 503. На Railway деплой MinIO и
# поставь его публичный домен ниже. Бакет нужно создать самому (например
# через web-консоль MinIO) и сделать публичный read.

# 🌐 ПУБЛИЧНЫЙ — полный URL MinIO-инстанса (с https://)
MINIO_ENDPOINT=https://minio-production-XXXX.up.railway.app

# 🔒 СЕКРЕТНЫЕ — ключи доступа из MinIO
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# 🌐 Имя бакета (создай в MinIO заранее)
MINIO_BUCKET=avatars

# 🌐 (опционально) Если фронт ходит к MinIO через другой домен — впиши его.
# По умолчанию = MINIO_ENDPOINT.
MINIO_PUBLIC_URL=


# -----------------------------------------------------------------------------
# СЕРВЕР
# -----------------------------------------------------------------------------
# 🌐 ПУБЛИЧНЫЕ — конфиг рантайма
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# SMS-провайдер (ТЗ §9.2, §13)
# Договора с SMS.kg у Академии пока нет — по умолчанию noop: сообщения
# копятся в очереди outbound_messages и помечаются пропущенными, наружу
# ничего не уходит. Когда ключи появятся — SMS_PROVIDER=smskg и четыре
# переменные ниже; код менять не нужно.
# Формат запроса при подключении сверить с документацией провайдера
# (backend/src/lib/sms.ts).
SMS_PROVIDER=noop
SMS_API_URL=
SMS_LOGIN=
SMS_PASSWORD=
SMS_SENDER=
